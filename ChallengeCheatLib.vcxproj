    <ClInclude Include="src\Localization.h" />
    <ClInclude Include="src\LocalizationData.h" />
    <ClInclude Include="src\PatternScan.h" />
    <ClInclude Include="src\TimedRideHook.h" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
