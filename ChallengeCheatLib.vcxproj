<?xml version="1.0" encoding="utf-8"?>
<!--
  The challenge writes, the timed-ride hook and their localized text as a
  static library, with no DllMain, menu, INI or log file of its own (see
  src/ChallengeCheatLog.h; the language comes from the host through
  Localization::SetLanguageOverride/SetLanguage). Linked by
  ChallengeCheat.vcxproj (the standalone ASI) and by Rampagio, which pulls
  this repo in as a submodule.

  Public headers: src/ChallengeCheat.h, src/TimedRideHook.h,
  src/Localization.h, src/ChallengeCheatLog.h. Calls natives (the
  external/ScriptHookSDK headers; the host links ScriptHookRDR2.lib) and
  includes MinHook.h without building MinHook: the host links its own copy
  and owns MH_Uninitialize. Script thread only.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\ChallengeCheat.cpp" />
    <ClCompile Include="src\ChallengeCheatLog.cpp" />
    <ClCompile Include="src\Localization.cpp" />
    <ClCompile Include="src\PatternScan.cpp" />
    <ClCompile Include="src\TimedRideHook.cpp" />
  </ItemGroup>
  <ItemGroup>
